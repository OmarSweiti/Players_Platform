# The local stack's settings (infra/compose.yaml). `just up` copies this file to
# infra/.env on the first run; change infra/.env, never this file.
#
# Development-only credentials: they open services bound to 127.0.0.1 on this
# machine and must never be used anywhere else.
POSTGRES_PASSWORD=sadara-local-only
KEYCLOAK_ADMIN_PASSWORD=sadara-local-only
OBJECT_STORE_ACCESS_KEY=sadara-local
OBJECT_STORE_SECRET_KEY=sadara-local-only
# The database's migrator and runtime role (0.4.2): the backend migrates as
# the first and runs as the second, never as POSTGRES_PASSWORD's superuser.
SADARA_MIGRATOR_PASSWORD=sadara-migrator-local-only
SADARA_APP_PASSWORD=sadara-app-local-only
# The API's client secrets at Keycloak (0.5.1, 0.5.4): the realm file reads
# them from here, and the backend's OIDC_CLIENT_SECRET and
# OIDC_ADMIN_CLIENT_SECRET carry the same values (its .env.example).
SADARA_API_CLIENT_SECRET=sadara-api-local-only
SADARA_ADMIN_CLIENT_SECRET=sadara-admin-local-only
# The provisioning command's service account (0.5.9): the backend's
# OIDC_PROVISIONER_CLIENT_SECRET carries the same value. Only that command
# holds it; the running API never does.
SADARA_PROVISIONER_CLIENT_SECRET=sadara-provisioner-local-only
# The security-event import's service account (0.7.3): the backend's
# OIDC_EVENTS_CLIENT_SECRET carries the same value. Only that command holds
# it; the running API never does.
SADARA_EVENTS_CLIENT_SECRET=sadara-events-local-only
# The development members' sign-in (0.5.11): every development account in the
# realm (infra/keycloak/README.md) has this password, and each privileged one
# this authenticator secret, which `just dev-cookie` and an authenticator app
# use. They exist only in the local Keycloak; never use them anywhere else.
SADARA_DEV_MEMBER_PASSWORD=sadara-member-local-only
SADARA_DEV_OTP_SECRET=sadara-otp-local-only

# Host ports, all on 127.0.0.1. If one is taken on your machine, change it here.
POSTGRES_PORT=5432
VALKEY_PORT=6379
OBJECT_STORE_PORT=7070
CLAMAV_PORT=3310
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
KEYCLOAK_PORT=8080
PROXY_HTTPS_PORT=443
PROXY_HTTP_PORT=80
